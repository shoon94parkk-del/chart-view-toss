value":2}]},{"role":"heading","name":"About AFTERNS","states":[{"name":"level","value":2}]},{"role":"heading","name":"Frequently asked questions (FAQ)","states":[{"name":"level","value":2}]},{"role":"heading","name":"What is AFTERNS?","states":[{"name":"level","value":3}]},{"role":"heading","name":"Does a stock go up when earnings are good?","states":[{"name":"level","value":3}]},{"role":"heading","name":"Can I see what was said on the earnings call?","states":[{"name":"level","value":3}]},{"role":"heading","name":"How can I check a US stock's next earnings date?","states":[{"name":"level","value":3}]},{"role":"heading","name":"How much does a stock usually move the day after earnings?","states":[{"name":"level","value":3}]},{"role":"button","name":"Watchlist","states":[{"name":"focusable","value":true},{"name":"invalid","value":"false"}]},{"role":"StaticText","name":"Data: SEC EDGAR · Yahoo Finance"},{"role":"image","name":"afterns"},{"role":"StaticText","name":"© "},{"role":"StaticText","name":"AFTERNS"},{"role":"StaticText","name":" · v"},{"role":"StaticText","name":"0.14.8"},{"role":"image","name":"Afterns"},{"role":"StaticText","name":"Afterns"},{"role":"StaticText","name":"Search stocks"},{"role":"StaticText","name":"Log in"},{"role":"button","name":"Menu","states":[{"name":"expanded","value":false},{"name":"focusable","value":true},{"name":"invalid","value":"false"}]},{"role":"heading","name":"US stock prices after earnings, the easiest placeto see","states":[{"name":"level","value":1}]},{"role":"link","name":"Today's key earnings Taiwan Semiconductor(ADR) vs forecast 1.7%","states":[{"name":"focusable","value":true}]},{"role":"button","name":"Top 20","states":[{"name":"expanded","value":false},{"name":"focusable","value":true},{"name":"hasPopup","value":"listbox"},{"name":"invalid","value":"false"}]},{"role":"StaticText","name":"S&P 500 largest by market cap"},{"role":"StaticText","name":"US earnings, the easiest place to see"},{"role":"StaticText","name":"AFTERNS brings together the earnings dates of 1,200+ US stocks, whether EPS and revenue beat expectations, what management actually said on the earnings call, and how the stock moved right after reporting. The weekly earnings brief covers everything that reported that week, and subscribing to the earnings calendar drops report dates straight into Google or Apple Calendar."},{"role":"StaticText","name":"What you can do on AFTERNS"},{"role":"StaticText","name":"About AFTERNS"},{"role":"StaticText","name":"AFTERNS is short for “After Earnings.” The numbers land within minutes of a release, but what you actually want to know is whether it was a good quarter and what the stock did about it. AFTERNS covers that part: whether results beat expectations, what management said on the call, and how the stock reacted on the day, kept per stock over the last 3 years (about 12 quarters). It also flags the results-vs-price mismatch, where a stock falls even on strong earnings."},{"role":"StaticText","name":"Frequently asked questions (FAQ)"},{"role":"StaticText","name":"What is AFTERNS?"},{"role":"StaticText","name":"AFTERNS (short for “After Earnings”) shows how each US-listed stock (1,200+, including the S&P 500) moved right after its earnings announcements, with a 3-year (about 12-quarter) timeline and statistics: next-day gain probability, average move on earnings day, reaction versus consensus beats/misses, guidance reaction, and the next earnings date."},{"role":"StaticText","name":"Does a stock go up when earnings are good?"},{"role":"StaticText","name":"Not always. Nearly half the time a stock falls even after beating consensus, because the market reacts to guidance and already-priced-in expectations, not just the reported number. We analyze this pattern per stock."},{"role":"StaticText","name":"Can I see what was said on the earnings call?"},{"role":"StaticText","name":"Yes. For major stocks we show what management actually said on the call, in the original English alongside a Korean translation, plus a one-line summary of the quarter and the positives and concerns."},{"role":"StaticText","name":"How can I check a US stock's next earnings date?"},{"role":"StaticText","name":"Each stock page shows the next scheduled earnings date, days remaining (D-day), whether it reports before or after market, and the consensus EPS estimate. The 'Upcoming' tab on the home page groups stocks reporting soon. You can also subscribe to the earnings calendar to get report dates in your Google or Apple Calendar automatically, with a reminder the night before."},{"role":"StaticText","name":"How much does a stock usually move the day after earnings?"},{"role":"StaticText","name":"It varies by stock. We show each stock's average earnings-day move, its largest single reaction, and next-day gain probability. Large caps typically move ±3–5%, while volatile names can move double digits."},{"role":"StaticText","name":" · "},{"role":"link","name":"Major stocks","states":[{"name":"focusable","value":true}]},{"role":"link","name":"Calendar","states":[{"name":"focusable","value":true}]},{"role":"link","name":"Guide","states":[{"name":"focusable","value":true}]},{"role":"link","name":"About","states":[{"name":"focusable","value":true}]},{"role":"link","name":"Privacy","states":[{"name":"focusable","value":true}]},{"role":"link","name":"Terms","states":[{"name":"focusable","value":true}]},{"role":"link","name":"Feedback","states":[{"name":"focusable","value":true}]},{"role":"link","name":"Home","states":[{"name":"focusable","value":true}]},{"role":"link","name":"Earnings (new)","states":[{"name":"focusable","value":true}]},{"role":"link","name":"Upcoming","states":[{"name":"focusable","value":true}]},{"role":"button","name":"Feedback","states":[{"name":"focusable","value":true},{"name":"invalid","value":"false"}]},{"role":"StaticText","name":"US stock prices after earnings,"},{"role":"LineBreak","name":"\n"},{"role":"StaticText","name":"Earnings dates, results, what th