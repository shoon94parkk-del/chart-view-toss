{
  "name": "chart-view-toss",
  "private": true,
  "version": "0.15.1",
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": ">=10 <12"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:research": "vite --config scripts/local-research-preview.config.mjs",
    "test": "node tests/ait_contract.cjs && node --test tests/*.test.mjs",
    "build": "npm test && vite build && node scripts/export-preview-routes.mjs && node tests/verify_preview_routes.mjs",
    "build:ait": "npm run build && ait build",
    "deploy:ait": "ait deploy",
    "preview": "vite preview --host 0.0.0.0",
    "test:e2e": "playwright test",
    "test:integration": "playwright test --grep integration",
    "test:e2e:report": "playwright show-report",
    "qa:prepush": "npm run build && npm run test:e2e",
    "test:e2e:live": "playwright test --config playwright.live.config.mjs"
  },
  "dependencies": {
    "@apps-in-toss/web-framework": "3.5.0",
    "lightweight-charts": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "vite": "^7.0.0"
  }
}
